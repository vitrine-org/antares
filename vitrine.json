{
  "id": "dev.vitrine.antares",
  "name": "Antares",
  "version": "2.1.0",
  "author": "Emanuele Frascella",
  "description": "Bold weekday, calendar, countdown, note, ring gauges, network, weather and a word clock in Metropolis and Montserrat",
  "homepage": "https://github.com/vitrine-org/antares",
  "minEngine": "2.0.0",
  "fonts": [
    "assets/fonts/Metropolis-Black.ttf",
    "assets/fonts/Montserrat-Regular.ttf",
    "assets/fonts/Montserrat-SemiBold.ttf"
  ],
  "widgets": [
    {
      "id": "date",
      "name": "Date",
      "description": "The weekday in Metropolis Black with the date below",
      "entry": "src/date/index.tsx",
      "settings": "src/date/settings.json",
      "preview": "src/date/preview.png",
      "size": { "default": [4, 2], "min": [3, 1], "max": [8, 3] },
      "permissions": []
    },
    {
      "id": "weather",
      "name": "Weather",
      "description": "Today's weather in a sentence beside an accent tile, from Open-Meteo",
      "entry": "src/weather/index.tsx",
      "settings": "src/weather/settings.json",
      "preview": "src/weather/preview.png",
      "size": { "default": [5, 1], "min": [4, 1], "max": [8, 2] },
      "permissions": ["net:api.open-meteo.com", "net:geocoding-api.open-meteo.com"]
    },
    {
      "id": "system",
      "name": "System",
      "description": "CPU, RAM and battery rings with their values",
      "entry": "src/system/index.tsx",
      "settings": "src/system/settings.json",
      "preview": "src/system/preview.png",
      "size": { "default": [5, 1], "min": [5, 1], "max": [8, 2] },
      "permissions": ["system.cpu", "system.memory", "system.battery", "system.drives"]
    },
    {
      "id": "wordclock",
      "name": "Word clock",
      "description": "The time in words: “Time is One.Forty Seven”",
      "entry": "src/wordclock/index.tsx",
      "settings": "src/wordclock/settings.json",
      "preview": "src/wordclock/preview.png",
      "size": { "default": [5, 1], "min": [3, 1], "max": [8, 2] },
      "permissions": []
    },
    {
      "id": "calendar",
      "name": "Calendar",
      "description": "“.November” in Metropolis Black over the month, today on an accent tile",
      "entry": "src/calendar/index.tsx",
      "settings": "src/calendar/settings.json",
      "preview": "src/calendar/preview.png",
      "size": { "default": [3, 3], "min": [3, 3], "max": [6, 6] },
      "permissions": []
    },
    {
      "id": "countdown",
      "name": "Countdown",
      "description": "Days to a date on the accent tile, the event in a sentence",
      "entry": "src/countdown/index.tsx",
      "settings": "src/countdown/settings.json",
      "preview": "src/countdown/preview.png",
      "size": { "default": [4, 1], "min": [3, 1], "max": [8, 2] },
      "permissions": []
    },
    {
      "id": "note",
      "name": "Note",
      "description": "A note under a bold “.Title”, written with a click",
      "entry": "src/note/index.tsx",
      "settings": "src/note/settings.json",
      "preview": "src/note/preview.png",
      "size": { "default": [3, 2], "min": [2, 2], "max": [6, 4] },
      "interactive": true,
      "permissions": []
    },
    {
      "id": "network",
      "name": "Network",
      "description": "Download and upload speed beside accent tiles",
      "entry": "src/network/index.tsx",
      "settings": "src/network/settings.json",
      "preview": "src/network/preview.png",
      "size": { "default": [4, 1], "min": [3, 1], "max": [8, 2] },
      "permissions": ["system.network"]
    }
  ]
}
